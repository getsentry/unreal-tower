#include "/Engine/Public/Platform.ush"

Buffer<int> Input;
RWBuffer<int> Output;

[numthreads(1, 1, 1)]
void HeavyComputeLoop(uint3 DispatchThreadId : SV_DispatchThreadID, uint GroupIndex : SV_GroupIndex)
{
	float x = 0;

	// Input[0] is 111 at runtime, so this loop never terminates. Because the bound comes from an
	// external buffer the shader compiler cannot resolve, it can't unroll, bound, or eliminate the
	// loop -- producing a real GPU hang (timeout) on all D3D12 platforms including Xbox.
	[loop]
	while (Input[0] != 0)
	{
		x += sin(x) * sin(Input[0]) * sin(Input[1]);
		Output[0] = (int)x;
	}

	Output[0] = (int)x;
}
