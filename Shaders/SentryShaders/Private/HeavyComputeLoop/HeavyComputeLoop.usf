#include "/Engine/Public/Platform.ush"

RWTexture2D<uint> PageFaultUAV;

[numthreads(1, 1, 1)]
void HeavyComputeLoop(uint3 DispatchThreadId : SV_DispatchThreadID, uint GroupIndex : SV_GroupIndex)
{
	// PageFaultUAV is backed by an invalid GPU address (created with TexCreate_Invalid),
	// so any access page-faults the GPU and removes the device. This mirrors the engine's
	// GPUDebugCrash "pagefault" mode and produces a device-removed crash rather than a hang.
	uint what = PageFaultUAV[uint2(0, 0)] + 1;

	uint OldValue = 0;
	InterlockedAdd(PageFaultUAV[uint2(0, 0)], 1, OldValue);
	if (OldValue == 0)
	{
		PageFaultUAV[uint2(0, 1)] = what;
	}
}
